# Phase 1 (Mac POC) environment variables.
# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Timezone (used by Frigate and the throwaway Home Assistant container) ---
TZ=America/Los_Angeles

# --- Isolated Phase 1 MQTT broker (research.md #4) ---
# This is a fresh, isolated Mosquitto instance for POC work — NOT the production
# Home Assistant Mosquitto broker. Never point this at the production broker during Phase 1.
MQTT_HOST=mosquitto
MQTT_PORT=1883

# --- Frigate ---
FRIGATE_CONFIG_PATH=./frigate/config/config.yml
# 5000 conflicts with macOS Control Center's AirPlay Receiver on most Macs — use 5001.
FRIGATE_UI_PORT=5001

# --- Throwaway Home Assistant instance (research.md #10) ---
# Disposable, Phase-1-only. NOT the production instance at 192.168.68.103.
HA_THROWAWAY_PORT=8124

# --- Phase 1 test video source (research.md #3) ---
# Path to the sample doorbell-angle video used by scripts/loop-test-video.sh.
# Populate this once sample media has been provided (pre-development-validation.md §5).
TEST_VIDEO_PATH=./tests/phase1/test-media/known-person-walk.mp4
