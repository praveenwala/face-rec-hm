# OS
.DS_Store

# Secrets / credentials — never commit these (constitution Principle II.4)
.env
.env.*
!.env.example
*secret*
!*secret*.example
.jwt_secret

# Identity/face data — never commit biometric data (constitution Principle II.4/II.5)
identity-library/
face-library/
*.face

# Sample/test media (photos, videos) and Frigate's own data volume — never commit
# household biometric data, per constitution II.4/II.5 and pre-development-validation.md §5
tests/phase1/test-media/
test-data/
frigate/data/
frigate/media/
frigate/clips/
frigate/recordings/
*.mp4
*.mov
*.mkv
*.avi
*.jpg
*.jpeg
*.png
*.heic
*.heif
!docs/**/*.png
!docs/**/*.jpg

# Real relationship mapping — contains household names; only the .example template is tracked
home-assistant/helpers/relationship_mapping.yaml
!home-assistant/helpers/relationship_mapping.yaml.example

# Home Assistant credentials/tokens if ever staged locally
home-assistant/**/secrets.yaml
home-assistant/**/.storage/

# Throwaway Home Assistant container's runtime config dir (docker-compose.yml
# ha-throwaway service) — entirely disposable generated state, never source-controlled
# (constitution II.4; research.md #10). Includes its own db, logs, blueprints, default
# YAML — none of it is authored by this project.
home-assistant/throwaway-config/

# Frigate's own runtime state (database, JWT secret, backups, export/timeline/vacuum
# markers) written into frigate/config/ at runtime by the bind mount — only config.yml
# in that directory is authored by this project and should be tracked.
frigate/config/*
!frigate/config/config.yml

# Database files anywhere in the repo — this project has no tracked database
# (constitution: storage is local filesystem only); anything matching is runtime state.
*.db
*.db-shm
*.db-wal

# ring-mqtt bridge runtime state (Phase 2, Constitution Phase 2) — config.json holds
# global config, ring-state.json holds the Ring refresh token (full account access).
# Both are created by the interactive init-ring-mqtt.js CLI and MUST never be committed
# (constitution II.4). Only ring-mqtt/README.md is tracked.
ring-mqtt/data/
ring-mqtt/config.json

# Local tooling
*.log

# Feature 002 — known person enrollment manager (constitution II.4/II.5)
# Private runtime storage: app.db + all uploaded biometric photo bytes live under
# enrollment-app/data/ and must NEVER be committed. Defense-in-depth: the global
# image-extension and *.db patterns above also cover this path.
enrollment-app/data/
enrollment-app/backend/.venv/
enrollment-app/frontend/node_modules/
enrollment-app/frontend/dist/
__pycache__/
*.py[cod]
.pytest_cache/
